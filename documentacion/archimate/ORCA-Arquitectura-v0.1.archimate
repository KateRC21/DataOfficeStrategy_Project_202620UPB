<folder name="Motivation" id="id-19c2ae4813ee47a7b2b3a29b61baea37" type="motivation">
<element xsi:type="archimate:Stakeholder" name="Contralor(a) Departamental" id="id-123da76296814187a4694d7742c8b08f"><documentation>Máxima autoridad; responde por la cobertura y oportunidad del control fiscal.</documentation></element>
<element xsi:type="archimate:Stakeholder" name="Ciudadanía y veedurías" id="id-cc36ba173bde47de941f82af17cf94a3"><documentation>Exigen transparencia y resultados del control a la contratación.</documentation></element>
<element xsi:type="archimate:Stakeholder" name="Equipo auditor" id="id-ae45f1eedbc44d2a90c9136cc6a2a42c"><documentation>Usuario final de las alertas y del tablero.</documentation></element>
<element xsi:type="archimate:Stakeholder" name="Titulares de datos personales (contratistas persona natural)" id="id-34ea125a694547caaa6569c2b3de7a19"><documentation>Protegidos por la Ley 1581 de 2012.</documentation></element>
<element xsi:type="archimate:Driver" name="Volumen: 302.507 contratos en Antioquia 2024-2026 (≈ $56,4 billones)" id="id-09e95ce0dc904f00b77dab40fb5723d5"><documentation>Medido vía API SODA sobre SECOP II (jbjy-vk9h), 27-sep-2026.</documentation></element>
<element xsi:type="archimate:Driver" name="85,5 % de los contratos se adjudican por contratación directa" id="id-cdb954d5ba25489ea96cca8a86b3e019"></element>
<element xsi:type="archimate:Driver" name="Pico pre-Ley de Garantías: 49.906 contratos firmados en enero de 2026" id="id-5f73d8db929a4f588cc42c346e0d12e7"></element>
<element xsi:type="archimate:Driver" name="Acto Legislativo 04/2019 y Decreto 403/2020: vigilancia y seguimiento permanente" id="id-46c28ac3b1f24b6a83bd1b5e6e1f5aca"></element>
<element xsi:type="archimate:Driver" name="Ley 1581 de 2012 (datos personales) y Ley 1712 de 2014 (transparencia)" id="id-23d0f4d756e24b66955e3924da563dbd"></element>
<element xsi:type="archimate:Assessment" name="La muestra de auditoría se elige por juicio experto: baja cobertura y sin trazabilidad" id="id-eabcc7e1c60e46a7addd579aa491ebcd"></element>
<element xsi:type="archimate:Assessment" name="Calidad heterogénea del SECOP: nulos disfrazados, atípicos, ciudades “No Definido”" id="id-548ae0ec61c442c8bfe33cfe1c064090"></element>
