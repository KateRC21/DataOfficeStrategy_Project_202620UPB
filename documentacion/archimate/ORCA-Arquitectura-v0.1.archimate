<element xsi:type="archimate:Goal" name="Priorizar la vigilancia fiscal con base en riesgo medible" id="id-ac0f0c7e29ca4f17b58c3006844613ce"></element>
<element xsi:type="archimate:Goal" name="Contar con datos de contratación confiables y gobernados" id="id-438e34bb3591432a9b1b4e1e405435d4"></element>
<element xsi:type="archimate:Goal" name="Proteger los datos personales en todo el ciclo de vida" id="id-14cb7042b89144debe124a770abc9937"></element>
<element xsi:type="archimate:Outcome" name="100 % de los contratos nuevos con score de riesgo en ≤ 24 h" id="id-b4c7359e747e4f66be0147bdc3197a96"></element>
<element xsi:type="archimate:Outcome" name="≥ 95 % de score de calidad por lote publicado" id="id-fb9d827fbffc4ba1b41c43428781a828"></element>
<element xsi:type="archimate:Outcome" name="0 datos personales en claro en el dashboard" id="id-71596bd5f13344d7a39e7d23433c2897"></element>
