o"><bpmn:outgoing>Flow_SQ0_SQ1</bpmn:outgoing></bpmn:startEvent><bpmn:parallelGateway id="SQ1"><bpmn:incoming>Flow_SQ0_SQ1</bpmn:incoming><bpmn:outgoing>Flow_SQ1_Q_comp</bpmn:outgoing><bpmn:outgoing>Flow_SQ1_Q_exac</bpmn:outgoing><bpmn:outgoing>Flow_SQ1_Q_cons</bpmn:outgoing><bpmn:outgoing>Flow_SQ1_Q_unic</bpmn:outgoing><bpmn:outgoing>Flow_SQ1_Q_vali</bpmn:outgoing><bpmn:outgoing>Flow_SQ1_Q_opor</bpmn:outgoing></bpmn:parallelGateway><bpmn:businessRuleTask id="Q_comp" name="Completitud: campos obligatorios y nulos disfrazados"><bpmn:incoming>Flow_SQ1_Q_comp</bpmn:incoming><bpmn:outgoing>Flow_Q_comp_SQ2</bpmn:outgoing></bpmn:businessRuleTask><bpmn:businessRuleTask id="Q_exac" name="Exactitud: montos atípicos y valores en cero"><bpmn:incoming>Flow_SQ1_Q_exac</bpmn:incoming><bpmn:outgoing>Flow_Q_exac_SQ2</bpmn:outgoing></bpmn:businessRuleTask><bpmn:businessRuleTask id="Q_cons" name="Consistencia: fecha inicio ≤ fin, valor pagado ≤ valor"><bpmn:incoming>Flow_SQ1_Q_cons</bpmn:incoming><bpmn:outgoing>Flow_Q_cons_SQ2</bpmn:outgoing></bpmn:businessRuleTask><bpmn:businessRuleTask id="Q_unic" name="Unicidad: id_contrato sin duplicados"><bpmn:incoming>Flow_SQ1_Q_unic</bpmn:incoming><bpmn:outgoing>Flow_Q_unic_SQ2</bpmn:outgoing></bpmn:businessRuleTask><bpmn:businessRuleTask id="Q_vali" name="Validez: dominios (modalidad, tipo doc., DIVIPOLA)"><bpmn:incoming>Flow_SQ1_Q_vali</bpmn:incoming><bpmn:outgoing>Flow_Q_vali_SQ2</bpmn:outgoing></bpmn:businessRuleTask><bpmn:businessRuleTask id="Q_opor" name="Oportunidad: rezago del lote frente al corte diario"><bpmn:incoming>Flow_SQ1_Q_opor</bpmn:incoming><bpmn:outgoing>Flow_Q_opor_SQ2</bpmn:outgoing></bpmn:businessRuleTask><bpmn:parallelGateway id="SQ2"><bpmn:incoming>Flow_Q_comp_SQ2</bpmn:incoming><bpmn:incoming>Flow_Q_exac_SQ2</bpmn:incoming><bpmn:incoming>Flow_Q_cons_SQ2</bpmn:incoming><bpmn:incoming>Flow_Q_unic_SQ2</bpmn:incoming><bpmn:incoming>Flow_Q_vali_SQ2</bpmn:incoming><bpmn:incoming>Flow_Q_opor_SQ2</bpmn:incoming><bpmn:outgoing>Flow_SQ2_SQ3</bpmn:outgoing></bpmn:parallelGateway><bpmn:businessRuleTask id="SQ3" name="Calcular score ponderado del lote"><bpmn:incoming>Flow_SQ2_SQ3</bpmn:incoming><bpmn:outgoing>Flow_SQ3_SQ4</bpmn:outgoing></bpmn:businessRuleTask><bpmn:endEvent id="SQ4" name="Informe de calidad emitido"><bpmn:incoming>Flow_SQ3_SQ4</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_SQ0_SQ1" sourceRef="SQ0" targetRef="SQ1" /><bpmn:sequenceFlow id="Flow_SQ1_Q_comp" sourceRef="SQ1" targetRef="Q_comp" /><bpmn:sequenceFlow id="Flow_Q_comp_SQ2" sourceRef="Q_comp" targetRef="SQ2" /><bpmn:sequenceFlow id="Flow_SQ1_Q_exac" sourceRef="SQ1" targetRef="Q_exac" /><bpmn:sequenceFlow id="Flow_Q_exac_SQ2" sourceRef="Q_exac" targetRef="SQ2" /><bpmn:sequenceFlow id="Flow_SQ1_Q_cons" sourceRef="SQ1" targetRef="Q_cons" /><bpmn:sequenceFlow id="Flow_Q_cons_SQ2" sourceRef="Q_cons" targetRef="SQ2" /><bpmn:sequenceFlow id="Flow_SQ1_Q_unic" sourceRef="SQ1" targetRef="Q_unic" /><bpmn:sequenceFlow id="Flow_Q_unic_SQ2" sourceRef="Q_unic" targetRef="SQ2" /><bpmn:sequenceFlow id="Flow_SQ1_Q_vali" sourceRef="SQ1" targetRef="Q_vali" /><bpmn:sequenceFlow id="Flow_Q_vali_SQ2" sourceRef="Q_vali" targetRef="SQ2" /><bpmn:sequenceFlow id="Flow_SQ1_Q_opor" sourceRef="SQ1" targetRef="Q_opor" /><bpmn:sequenceFlow id="Flow_Q_opor_SQ2" sourceRef="Q_opor" targetRef="SQ2" /><bpmn:sequenceFlow id="Flow_SQ2_SQ3" sourceRef="SQ2" targetRef="SQ3" /><bpmn:sequenceFlow id="Flow_SQ3_SQ4" sourceRef="SQ3" targetRef="SQ4" /></bpmn:subProcess><bpmn:dataObject id="DO2_obj" /><bpmn:dataObjectReference id="DO2" name="Informe de calidad del lote" dataObjectRef="DO2_obj" /><bpmn:parallelGateway id="G2"><bpmn:incoming>Flow_T2_G2</bpmn:incoming><bpmn:incoming>Flow_SP1_G2</bpmn:incoming><bpmn:outgoing>Flow_G2_G3</bpmn:outgoing></bpmn:parallelGateway><bpmn:exclusiveGateway id="G3" name="¿Score de calidad ≥ 95 %?" default="Flow_G3_TS1"><bpmn:incoming>Flow_G2_G3</bpmn:incoming><bpmn:outgoing>Flow_G3_GM1</bpmn:outgoing><bpmn:outgoing>Flow_