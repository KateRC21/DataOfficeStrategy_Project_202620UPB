incoming>Flow_BE1_TE1</bpmn:incoming><bpmn:outgoing>Flow_TE1_GE</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="GE" name="¿Intentos &lt; 3?" default="Flow_GE_ET"><bpmn:incoming>Flow_TE1_GE</bpmn:incoming><bpmn:outgoing>Flow_GE_TM1</bpmn:outgoing><bpmn:outgoing>Flow_GE_ET</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:intermediateCatchEvent id="TM1" name="Esperar 1 h (backoff)"><bpmn:incoming>Flow_GE_TM1</bpmn:incoming><bpmn:outgoing>Flow_TM1_GM0</bpmn:outgoing><bpmn:timerEventDefinition id="TED_TM1"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:endEvent id="ET" name="Extracción fallida: incidente escalado"><bpmn:incoming>Flow_GE_ET</bpmn:incoming><bpmn:terminateEventDefinition id="TER_ET" /></bpmn:endEvent><bpmn:userTask id="TS1" name="Revisar incidente de calidad y decidir"><bpmn:incoming>Flow_G3_TS1</bpmn:incoming><bpmn:outgoing>Flow_TS1_GS</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="GS" name="¿Liberar lote con advertencia?" default="Flow_GS_E_q"><bpmn:incoming>Flow_TS1_GS</bpmn:incoming><bpmn:outgoing>Flow_GS_GM1</bpmn:outgoing><bpmn:outgoing>Flow_GS_E_q</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:endEvent id="E_q" name="Lote en cuarentena"><bpmn:incoming>Flow_GS_E_q</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="T7" name="Analizar alerta con evidencia del SECOP"><bpmn:incoming>Flow_T6_T7</bpmn:incoming><bpmn:outgoing>Flow_T7_G6</bpmn:outgoing></bpmn:userTask><bpmn:boundaryEvent id="BT" name="3 días hábiles sin gestión" attachedToRef="T7" cancelActivity="false"><bpmn:outgoing>Flow_BT_EE</bpmn:outgoing><bpmn:timerEventDefinition id="TED_BT"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:endEvent id="EE" name="Alerta escalada al Contralor Auxiliar"><bpmn:incoming>Flow_BT_EE</bpmn:incoming><bpmn:escalationEventDefinition id="ESC_EE" escalationRef="Esc_sla" /></bpmn:endEvent><bpmn:exclusiveGateway id="G6" name="¿Alerta pertinente?" default="Flow_G6_T8"><bpmn:incoming>Flow_T7_G6</bpmn:incoming><bpmn:outgoing>Flow_G6_T9</bpmn:outgoing><bpmn:outgoing>Flow_G6_T8</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T8" name="Registrar falso positivo y recalibrar reglas"><bpmn:incoming>Flow_G6_T8</bpmn:incoming><bpmn:outgoing>Flow_T8_E_fp</bpmn:outgoing><bpmn:dataOutputAssociation id="DOA_T8_DS3"><bpmn:targetRef>DS3</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask><bpmn:dataStoreReference id="DS3" name="Reglas de riesgo versionadas" /><bpmn:endEvent id="E_fp" name="Alerta descartada (retroalimenta el modelo)"><bpmn:incoming>Flow_T8_E_fp</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="T9" name="Priorizar sujeto y definir tipo de actuación"><bpmn:incoming>Flow_G6_T9</bpmn:incoming><bpmn:outgoing>Flow_T9_G7</bpmn:outgoing></bpmn:userTask><bpmn:inclusiveGateway id="G7" name="¿Qué actuación?" default="Flow_G7_T11"><bpmn:incoming>Flow_T9_G7</bpmn:incoming><bpmn:outgoing>Flow_G7_T10</bpmn:outgoing><bpmn:outgoing>Flow_G7_T11</bpmn:outgoing></bpmn:inclusiveGateway><bpmn:sendTask id="T10" name="Emitir alerta temprana a la entidad"><bpmn:incoming>Flow_G7_T10</bpmn:incoming><bpmn:outgoing>Flow_T10_G8</bpmn:outgoing></bpmn:sendTask><bpmn:userTask id="T11" name="Incluir en el Plan de Vigilancia (PVCF)"><bpmn:incoming>Flow_G7_T11</bpmn:incoming><bpmn:outgoing>Flow_T11_G8</bpmn:outgoing></bpmn:userTask><bpmn:inclusiveGateway id="G8"><bpmn:incoming>Flow_T10_G8</bpmn:incoming><bpmn:incoming>Flow_T11_G8</bpmn:incoming><bpmn:outgoing>Flow_G8_E_fin</bpmn:outgoing></bpmn:inclusiveGateway><bpmn:endEvent id="E_fin" name="Actuación fiscal programada"><bpmn:incoming>Flow_G8_E_fin</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_S1_GM0" sourceRef="S1" targetRef="GM0" /><bpmn:sequenceFlow id="Flow_GM0_T1" sourceRef="GM0" targetRef="T1" /><bpmn:sequenceFlow id="Flow_T1_G1" sourceRef="T1" targetRef="G1" /><bpmn:sequenceFlow id="Flow_G1_T2" sourceRef="G1" targetRef="T2" /><bpmn:sequenceFlow id="Flow_G1_SP1" sourceRef="G1" targetRef="SP1" /><bpmn:sequenceFlow id="Flow_T2_G2" sourceRef="T2" targetRef="G2" /><bpmn:sequenceFlow id="Flow_SP1_G2" sourceRef="SP1" targetRef="G2" /><bpmn:sequenceFlow id="Flow_G2_G3" sourceRef="G2" targetRef="G3" /><bpmn:sequenceFlow id="Flow_G3_GM1" sourceRef="G3" targetRef="GM1" name="Sí"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${score_calidad &gt;= 0.95}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_G3_TS1" sourceRef="G3" targetRef="TS1" name="No"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${score_calidad &lt; 0.95}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_TS1_GS" sourceRef="TS1" targetRef="GS" /><bpmn:sequenceFlow id="Flow_GS_GM1" sourceRef="GS" targetRef="GM1" name="Sí"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${liberar == true}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_GS_E_q" sourceRef="GS" targetRef="E_q" name="No" /><bpmn:sequenceFlow id="Flow_GM1_T3" sourceRef="GM1" targetRef="T3" /><bpmn:sequenceFlow id="Flow_T3_T4" sourceRef="T3" targetRef="T4" /><bpmn:sequenceFlow id="Flow_T4_T5" sourceRef="T4" targetRef="T5" /><bpmn:sequenceFlow id="Flow_T5_G5" sourceRef="T5" targetRef="G5" /><bpmn:sequenceFlow id="Flow_G5_T6" sourceRef="G5" targetRef="T6" name="Sí"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${alertas_altas &gt; 0}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_G5_E_ok" sourceRef="G5" targetRef="E_ok" name="No"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${alertas_altas == 0}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_T6_T7" sourceRef="T6" targetRef="T7" /><bpmn:sequenceFlow id="Flow_BE1_TE1" sourceRef="BE1" targetRef="TE1" /><bpmn:sequenceFlow id="Flow_TE1_GE" sourceRef="TE1" targetRef="GE" /><bpmn:sequenceFlow id="Flow_GE_TM1" sourceRef="GE" targetRef="TM1" name="Sí"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${intentos &lt; 3}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_GE_ET" sourceRef="GE" targetRef="ET" name="No"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${intentos &gt;= 3}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_TM1_GM0" sourceRef="TM1" targetRef="GM0" name="Reintentar" /><bpmn:sequenceFlow id="Flow_T7_G6" sourceRef="T7" targetRef="G6" /><bpmn:sequenceFlow id="Flow_BT_EE" sourceRef="BT" targetRef="EE" /><bpmn:sequenceFlow id="Flow_G6_T9" sourceRef="G6" targetRef="T9" name="Sí"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pertinente == true}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_G6_T8" sourceRef="G6" targetRef="T8" name="No"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pertinente == false}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_T8_E_fp" sourceRef="T8" targetRef="E_fp" /><bpmn:sequenceFlow id="Flow_T9_G7" sourceRef="T9" targetRef="G7" /><bpmn:sequenceFlow id="Flow_G7_T10" sourceRef="G7" targetRef="T10" name="Riesgo inminente"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${riesgo_inminente == true}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_G7_T11" sourceRef="G7" targetRef="T11" name="Requiere auditoría" /><bpmn:sequenceFlow id="Flow_T10_G8" sourceRef="T10" targetRef="G8" /><bpmn:sequenceFlow id="Flow_T11_G8" sourceRef="T11" targetRef="G8" /><bpmn:sequenceFlow id="Flow_G8_E_fin" sourceRef="G8" targetRef="E_fin" /><bpmn:textAnnotation id="LEG"><bpmn:text>Leyenda · Azul = tarea automatizada [AUTO] · Morado = decisión de gobierno del dato · M# = mejora frente al AS-IS (ver 03_procesos_bpmn.md, tabla de mejoras).</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="GXP"><bpmn:text>Gestión por excepción: el auditor ya no busca contratos. Solo recibe alertas de riesgo alto, priorizadas y con el enlace al proceso en SECOP II.</bpmn:text></bpmn:textAnnotation><bpmn:textAnnotation id="M1"><bpmn:text>M1 · Ingesta diaria por API sustituye la búsqueda manual y la extracción ad hoc (D2, D3).</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_M1" associationDirection="None" sourceRef="M1" targetRef="S1" /><bpmn:textAnnotation id="M2"><bpmn:text>M2 · Quality gate: con score ≥ 95 % el lote sigue solo; si no, decide el Data Steward. El dato defectuoso nunca llega al dashboard (D4).</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_M2" associationDirection="None" sourceRef="M2" targetRef="G3" /><bpmn:textAnnotation id="M3"><bpmn:text>M3 · Cédulas de personas naturales, supervisores y ordenadores del gasto se seudonimizan antes de cualquier consumo (Ley 1581 de 2012).</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_M3" associationDirection="None" sourceRef="M3" targetRef="T3" /><bpmn:textAnnotation id="M4"><bpmn:text>M4 · Selección por riesgo: banderas rojas ponderadas sustituyen el juicio experto (D1, D5).</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_M4" associationDirection="None" sourceRef="M4" targetRef="T4" /><bpmn:textAnnotation id="M5"><bpmn:text>M5 · Alertas con SLA de 3 días hábiles y escalamiento automático (D6).</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_M5" associationDirection="None" sourceRef="M5" targetRef="T6" /><bpmn:textAnnotation id="M6"><bpmn:text>M6 · Los falsos positivos recalibran las reglas: ciclo de mejora continua (D7).</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_M6" associationDirection="None" sourceRef="M6" targetRef="T8" /></bpmn:process>
<bpmn:error id="Err_api" name="Fallo API SODA" errorCode="API_SODA_FAIL" />
<bpmn:escalation id="Esc_sla" name="SLA de alerta vencido" escalationCode="SLA_ALERTA" />
