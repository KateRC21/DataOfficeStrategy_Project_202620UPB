<bpmn:process id="Proc_main" isExecutable="false"><bpmn:laneSet id="LaneSet_Proc_main"><bpmn:lane id="L_plan" name="Dirección de Planeación / Contralor Auxiliar"><bpmn:flowNodeRef>S_a</bpmn:flowNodeRef><bpmn:flowNodeRef>T_a</bpmn:flowNodeRef><bpmn:flowNodeRef>T_h</bpmn:flowNodeRef><bpmn:flowNodeRef>E_1</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_aud" name="Equipo Auditor"><bpmn:flowNodeRef>T_b</bpmn:flowNodeRef><bpmn:flowNodeRef>G_a</bpmn:flowNodeRef><bpmn:flowNodeRef>G_m</bpmn:flowNodeRef><bpmn:flowNodeRef>T_d</bpmn:flowNodeRef><bpmn:flowNodeRef>T_e</bpmn:flowNodeRef><bpmn:flowNodeRef>G_m2</bpmn:flowNodeRef><bpmn:flowNodeRef>T_f</bpmn:flowNodeRef><bpmn:flowNodeRef>EBG</bpmn:flowNodeRef><bpmn:flowNodeRef>M_c</bpmn:flowNodeRef><bpmn:flowNodeRef>Tm_c</bpmn:flowNodeRef><bpmn:flowNodeRef>T_g</bpmn:flowNodeRef><bpmn:flowNodeRef>G_b</bpmn:flowNodeRef><bpmn:flowNodeRef>E_2</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_tic" name="Oficina TIC (soporte)"><bpmn:flowNodeRef>T_c</bpmn:flowNodeRef><bpmn:flowNodeRef>DO_a</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="S_a" name="Inicio de vigencia fiscal (anual)"><bpmn:outgoing>Flow_S_a_T_a</bpmn:outgoing><bpmn:timerEventDefinition id="TED_S_a"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/P1Y</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent><bpmn:userTask id="T_a" name="Elaborar Plan de Vigilancia (PVCF) por criterio histórico"><bpmn:incoming>Flow_S_a_T_a</bpmn:incoming><bpmn:outgoing>Flow_T_a_T_b</bpmn:outgoing></bpmn:userTask><bpmn:userTask id="T_b" name="Buscar contratos en el portal SECOP II (consulta manual)"><bpmn:incoming>Flow_T_a_T_b</bpmn:incoming><bpmn:outgoing>Flow_T_b_G_a</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G_a" name="¿Volumen manejable desde el portal?" default="Flow_G_a_G_m"><bpmn:incoming>Flow_T_b_G_a</bpmn:incoming><bpmn:outgoing>Flow_G_a_G_m</bpmn:outgoing><bpmn:outgoing>Flow_G_a_T_c</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T_c" name="Extraer base de SECOP y enviarla en Excel (ad hoc)"><bpmn:incoming>Flow_G_a_T_c</bpmn:incoming><bpmn:outgoing>Flow_T_c_G_m</bpmn:outgoing></bpmn:userTask><bpmn:dataObject id="DO_a_obj" /><bpmn:dataObjectReference id="DO_a" name="Archivos Excel sin control de versiones" dataObjectRef="DO_a_obj" /><bpmn:exclusiveGateway id="G_m"><bpmn:incoming>Flow_G_a_G_m</bpmn:incoming><bpmn:incoming>Flow_T_c_G_m</bpmn:incoming><bpmn:outgoing>Flow_G_m_T_d</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="T_d" name="Consolidar y depurar hojas de cálculo"><bpmn:incoming>Flow_G_m_T_d</bpmn:incoming><bpmn:outgoing>Flow_T_d_T_e</bpmn:outgoing><bpmn:property id="Prop_T_d" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="DIA_DO_a_T_d"><bpmn:sourceRef>DO_a</bpmn:sourceRef><bpmn:targetRef>Prop_T_d</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:userTask><bpmn:userTask id="T_e" name="Seleccionar muestra de contratos por juicio experto"><bpmn:incoming>Flow_T_d_T_e</bpmn:incoming><bpmn:outgoing>Flow_T_e_G_m2</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G_m2"><bpmn:incoming>Flow_T_e_G_m2</bpmn:incoming><bpmn:incoming>Flow_Tm_c_G_m2</bpmn:incoming><bpmn:outgoing>Flow_G_m2_T_f</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sendTask id="T_f" name="Solicitar soportes contractuales a la entidad"><bpmn:incoming>Flow_G_m2_T_f</bpmn:incoming><bpmn:outgoing>Flow_T_f_EBG</bpmn:outgoing></bpmn:sendTask><bpmn:eventBasedGateway id="EBG"><bpmn:incoming>Flow_T_f_EBG</bpmn:incoming><bpmn:outgoing>Flow_EBG_M_c</bpmn:outgoing><bpmn:outgoing>Flow_EBG_Tm_c</bpmn:outgoing></bpmn:eventBasedGateway><bpmn:intermediateCatchEvent id="M_c" name="Soportes recibidos"><bpmn:incoming>Flow_EBG_M_c</bpmn:incoming><bpmn:outgoing>Flow_M_c_T_g</bpmn:outgoing><bpmn:messageEventDefinition id="MED_M_c" messageRef="Msg_soportes" /></bpmn:intermediateCatchEvent><bpmn:intermediateCatchEvent id="Tm_c" name="10 días hábiles sin respuesta"><bpmn:incoming>Flow_EBG_Tm_c</bpmn:incoming><bpmn:outgoing>Flow_Tm_c_G_m2</bpmn:outgoing><bpmn:timerEventDefinition id="TED_Tm_c"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P10D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent><bpmn:userTask id="T_g" name="Revisar contratos de la muestra"><bpmn:incoming>Flow_M_c_T_g</bpmn:incoming><bpmn:outgoing>Flow_T_g_G_b</bpmn:outgoing></bpmn:userTask><bpmn:exclusiveGateway id="G_b" name="¿Presuntos hallazgos?" default="Flow_G_b_E_2"><bpmn:incoming>Flow_T_g_G_b</bpmn:incoming><bpmn:outgoing>Flow_G_b_T_h</bpmn:outgoing><bpmn:outgoing>Flow_G_b_E_2</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sendTask id="T_h" name="Validar y comunicar informe de auditoría"><bpmn:incoming>Flow_G_b_T_h</bpmn:incoming><bpmn:outgoing>Flow_T_h_E_1</bpmn:outgoing></bpmn:sendTask><bpmn:endEvent id="E_1" name="Informe con hallazgos"><bpmn:incoming>Flow_T_h_E_1</bpmn:incoming></bpmn:endEvent><bpmn:endEvent id="E_2" name="Informe sin hallazgos"><bpmn:incoming>Flow_G_b_E_2</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_S_a_T_a" sourceRef="S_a" targetRef="T_a" /><bpmn:sequenceFlow id="Flow_T_a_T_b" sourceRef="T_a" targetRef="T_b" /><bpmn:sequenceFlow id="Flow_T_b_G_a" sourceRef="T_b" targetRef="G_a" /><bpmn:sequenceFlow id="Flow_G_a_G_m" sourceRef="G_a" targetRef="G_m" name="Sí"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${volumen &lt;= 500}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_G_a_T_c" sourceRef="G_a" targetRef="T_c" name="No"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${volumen &gt; 500}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_T_c_G_m" sourceRef="T_c" targetRef="G_m" /><bpmn:sequenceFlow id="Flow_G_m_T_d" sourceRef="G_m" targetRef="T_d" /><bpmn:sequenceFlow id="Flow_T_d_T_e" sourceRef="T_d" targetRef="T_e" /><bpmn:sequenceFlow id="Flow_T_e_G_m2" sourceRef="T_e" targetRef="G_m2" /><bpmn:sequenceFlow id="Flow_G_m2_T_f" sourceRef="G_m2" targetRef="T_f" /><bpmn:sequenceFlow id="Flow_T_f_EBG" sourceRef="T_f" targetRef="EBG" /><bpmn:sequenceFlow id="Flow_EBG_M_c" sourceRef="EBG" targetRef="M_c" /><bpmn:sequenceFlow id="Flow_EBG_Tm_c" sourceRef="EBG" targetRef="Tm_c" /><bpmn:sequenceFlow id="Flow_Tm_c_G_m2" sourceRef="Tm_c" targetRef="G_m2" name="Reiterar solicitud" /><bpmn:sequenceFlow id="Flow_M_c_T_g" sourceRef="M_c" targetRef="T_g" /><bpmn:sequenceFlow id="Flow_T_g_G_b" sourceRef="T_g" targetRef="G_b" /><bpmn:sequenceFlow id="Flow_G_b_T_h" sourceRef="G_b" targetRef="T_h" name="Sí"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hallazgos &gt; 0}</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_G_b_E_2" sourceRef="G_b" targetRef="E_2" name="No" /><bpmn:sequenceFlow id="Flow_T_h_E_1" sourceRef="T_h" targetRef="E_1" /><bpmn:textAnnotation id="D1"><bpmn:text>D1 · La planeación se basa en el histórico y el criterio del auditor, no en un indicador de riesgo medible.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_D1" associationDirection="None" sourceRef="D1" targetRef="T_a" /><bpmn:textAnnotation id="D2"><bpmn:text>D2 · Consulta manual en el portal: sin API ni registro de qué se consultó y cuándo (sin linaje).</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_D2" associationDirection="None" sourceRef="D2" targetRef="T_b" /><bpmn:textAnnotation id="D3"><bpmn:text>D3 · Dependencia de TIC: extracciones ad hoc que tardan días; nadie es dueño del dato.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_D3" associationDirection="None" sourceRef="D3" targetRef="T_c" /><bpmn:textAnnotation id="D4"><bpmn:text>D4 · Depuración en Excel sin reglas de calidad; cédulas y datos personales se copian sin control (Ley 1581).</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_D4" associationDirection="None" sourceRef="D4" targetRef="T_d" /><bpmn:textAnnotation id="D5"><bpmn:text>D5 · Muestra por juicio experto: baja cobertura, sesgo y ninguna trazabilidad del porqué.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_D5" associationDirection="None" sourceRef="D5" targetRef="T_e" /><bpmn:textAnnotation id="D6"><bpmn:text>D6 · Esperas sin SLA y reiteraciones manuales a la entidad.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_D6" associationDirection="None" sourceRef="D6" targetRef="EBG" /><bpmn:textAnnotation id="D7"><bpmn:text>D7 · El resultado no retroalimenta la selección: la siguiente vigencia se planea igual.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_D7" associationDirection="None" sourceRef="D7" targetRef="T_g" /></bpmn:process>
<bpmn:message id="Msg_soportes" name="Soportes contractuales" />
